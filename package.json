{
  "name": "ai-tagger-universe",
  "version": "1.0.20",
  "description": "Automatically analyze note content and add relevant tags using AI (with Chinese interface support)",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "npx tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "version": "node version-bump.mjs && git add manifest.json versions.json"
  },
  "keywords": [
    "obsidian",
    "plugin",
    "ai",
    "tags",
    "chinese",
    "internationalization"
  ],
  "author": "Nie Hu",
  "license": "MIT",
  "devDependencies": {
    "@types/d3": "^7.4.3",
    "@types/node": "^16.11.7",
    "esbuild": "^0.28.2",
    "obsidian": "latest",
    "tslib": "2.4.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "d3": "^7.9.0"
  }
}
